---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" layoutClass="page">
  <div class="contact-page">
    <h1>Contact</h1>

    <div class="contact-links">
      <div class="contact-item">
        <h3>Social Media</h3>
        <ul>
          <li><a href="https://twitter.com/tomusdrw" target="_blank">Twitter (@tomusdrw)</a></li>
          <li><a href="https://github.com/tomusdrw" target="_blank">GitHub (tomusdrw)</a></li>
          <li><a href="https://www.linkedin.com/in/tomaszdrwiega/" target="_blank">LinkedIn (tomaszdrwiega)</a></li>
        </ul>
      </div>

      <div class="contact-item">
        <h3>Professional</h3>
        <p>Feel free to reach out through any of the social media channels above for professional inquiries, collaboration opportunities, or just to say hello!</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.contact-page {
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem;
}

.contact-links {
  margin-top: 2rem;
}

.contact-item {
  margin-bottom: 2rem;
  padding: 1.5rem;
  background: var(--terminal-green-005);
  border: 1px solid var(--terminal-green-02);
  border-radius: 5px;
}

.contact-item h3 {
  color: var(--terminal-green);
  margin-bottom: 1rem;
}

.contact-item ul {
  list-style: none;
  padding: 0;
}

.contact-item li {
  margin-bottom: 0.5rem;
}

.contact-item a {
  color: var(--terminal-green);
  text-decoration: none;
  transition: all 0.3s ease;
}

.contact-item a:hover {
  text-shadow: 0 0 5px var(--terminal-green-glow);
}
</style>
